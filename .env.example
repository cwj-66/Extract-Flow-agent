DASHSCOPE_API_KEY=

# 推荐：docker compose up -d（Compose 会给 backend 注入 Postgres/Redis）
# 仅本机跑 API 时再取消下面两行注释：
# DATABASE_URL=postgresql+psycopg://extract:extract@127.0.0.1:5432/extract_flow
# REDIS_URL=redis://127.0.0.1:6379/0
USE_CELERY=false
PIPELINE_CONCURRENCY=3

POSTGRES_USER=extract
POSTGRES_PASSWORD=extract
POSTGRES_DB=extract_flow
