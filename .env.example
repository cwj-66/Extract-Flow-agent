DASHSCOPE_API_KEY=

# 在 https://mineru.net/apiManage 创建 Token，仅填写原始值，不加 Bearer。
# cloud 会把上传的 PDF 发送至 MinerU 官方云端，不需要本地模型。
MINERU_MODE=cloud
MINERU_API_TOKEN=
MINERU_API_BASE_URL=https://mineru.net
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=ch
MINERU_TIMEOUT_SEC=1200
MINERU_REQUEST_TIMEOUT_SEC=60
MINERU_POLL_INTERVAL_SEC=3
# 仅 local 模式的 Docker 镜像需要开启；4GB 服务器保持 false。
INSTALL_LOCAL_MINERU=false

# 推荐：docker compose up -d（Compose 会给 backend 注入 Postgres/Redis）
# 仅本机跑 API 时再取消下面两行注释：
# DATABASE_URL=postgresql+psycopg://extract:extract@127.0.0.1:5432/extract_flow
# REDIS_URL=redis://127.0.0.1:6379/0
USE_CELERY=false
PIPELINE_CONCURRENCY=3

POSTGRES_USER=extract
POSTGRES_PASSWORD=extract
POSTGRES_DB=extract_flow
